<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
  >
  <link
    rel="stylesheet"
    href="css/bootstrap.min.css"
  >
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  {{!-- <link
    rel="stylesheet"
    href="css/chat.css"
  /> --}}
  <link
    rel="stylesheet"
    href="css/style.css"
  >


  <title>Ecommerce Backend</title>
</head>

<div class="container mt-5">
  <h1 class="text-center mb-4">{{this.title}}</h1>

  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4">
    {{#each list}}
    <div class="col mb-4">
      <div class="card h-100 bg-light ">
        <div class="card-header  text-white">
          <i class="bi bi-tag"></i> Code: {{this.code}}
        </div>
        <div class="card-body">
          <h5 class="card-title text-white">{{this.title}}</h5>
          <ul class="list-unstyled">
            <li><i class="bi bi-info-circle"></i> ID: {{this._id}}</li>
            <li><i class="bi bi-file-text"></i> Description: {{this.description}}</li>
            <li><i class="bi bi-currency-dollar"></i> Price: ${{this.price}}</li>
            <li><i class="bi bi-grid"></i> Category: {{this.category}}</li>
            <li><i class="bi bi-check-circle"></i> Status: {{this.status}}</li>
            <li><i class="bi bi-box"></i> Stock: {{this.stock}}</li>
            <li>
              <i class="bi bi-image"></i> Image: <img
                src="{{this.thumbnail}}"
                alt="{{this.title}}"
                class="img-fluid mt-2"
              >
            </li>
          </ul>


        </div>
        <button
          type="button"
          class="addCard btn btn-success position-absolute top-0 end-0"
        ><i class="bi bi-cart-plus"></i></button>
      </div>
    </div>
    {{/each}}
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
