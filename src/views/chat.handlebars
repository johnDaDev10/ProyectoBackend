<head>

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
  >
  <link
    rel="stylesheet"
    href="css/bootstrap.min.css"
  >
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link
    rel="stylesheet"
    href="css/chat.css"
  />
  <link
    rel="stylesheet"
    href="css/style.css"
  >


  <title>Ecommerce Backend - Chat</title>
</head>

<div id="chat-container"> 
  <div id="chat-header">
    <h4 class='colorHeaderChat'>Chat Ecommerce</h4>
    <h6
      class='colorHeaderChat'
      id="nombreusuario"
    >{{user.firstName}} {{user.lastName}}</h6>
    <img
      src="https://i.ibb.co/DY2fSwC/Open-Peeps-Bust-16.png"
      alt="Logo Customer"
      id="customer-logo"
    >
  </div>
  <div id="chat-messages">

    <div class="message sender">
      <div class="user-info">
        <div class="sender-name">Conectado</div>
      </div>
      <div id="chat">Cargando mensajes...</div>
    </div>
  </div>
  <form id="formulario">
    <input
      type="text"
      name="mensaje"
      id="mensaje"
      placeholder="Type your message..."
    >
    <button id="sendMessage"><i class="fas fa-paper-plane"></i> Enviar</button>
    <button id="clearChat"><i class="fas fa-trash"></i> Vaciar Chat</button>
  </form>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

<script
  type="text/javascript"
  src="https://cdn.jsdelivr.net/npm/toastify-js"
></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/socket.io/socket.io.js"></script>
<script src="js/realTimeChat.js"></script>